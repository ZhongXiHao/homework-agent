# Model name
LLM_MODEL_ID=your_model_id_here

# API key
LLM_API_KEY=your_api_key_here

# Service URL
LLM_BASE_URL=your_service_url_here

# Request timeout (in seconds; default is 60)
LLM_TIMEOUT=60

# CANVAS API key, don't use it on development environment, it may cause your account to be banned.
CANVAS_API_KEY=your_canvas_api_key_here